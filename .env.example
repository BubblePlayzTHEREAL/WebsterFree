# Merriam-Webster Collegiate API keys — get yours at
# https://www.dictionaryapi.com/register.htm (free, 1,000 refs/day per key)
#
# Request BOTH a "Collegiate Dictionary" key AND a "Collegiate Thesaurus" key.
# Without these, the app falls back to Wiktionary data (also fine).

MERRIAM_WEBSTER_DICTIONARY_API_KEY=your-dictionary-key-here
MERRIAM_WEBSTER_THESAURUS_API_KEY=your-thesaurus-key-here

# SQLite database file (used by Prisma)
DATABASE_URL="file:./db/custom.db"
